<%- include('../partials/header') %>


<main class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-dark">
                    <h2 class="h4 mb-0 py-2">Edit Game: <%= game.title %></h2>
                </div>
                <div class="card-body p-4">
                    
                    <% if (error && error.length > 0) { %>
                        <div class="alert alert-danger"><%= error[0] %></div>
                    <% } %>

                    <form action="/games/edit/<%= game.game_id %>" method="POST" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="title" class="form-label fw-bold">Game Title <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="title" name="title" value="<%= game.title %>" required>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="genre" class="form-label fw-bold">Genre</label>
                                <input type="text" class="form-control" id="genre" name="genre" value="<%= game.genre %>">
                            </div>
                            <div class="col-md-6">
                                <label for="difficulty" class="form-label fw-bold">Difficulty</label>
                                <select class="form-select" id="difficulty" name="difficulty">
                                    <option value="easy" <%= game.difficulty === 'easy' ? 'selected' : '' %>>Easy</option>
                                    <option value="medium" <%= game.difficulty === 'medium' ? 'selected' : '' %>>Medium</option>
                                    <option value="hard" <%= game.difficulty === 'hard' ? 'selected' : '' %>>Hard</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="min_players" class="form-label fw-bold">Min Players</label>
                                <input type="number" class="form-control" id="min_players" name="min_players" min="1" value="<%= game.min_players %>">
                            </div>
                            <div class="col-md-6">
                                <label for="max_players" class="form-label fw-bold">Max Players</label>
                                <input type="number" class="form-control" id="max_players" name="max_players" min="1" value="<%= game.max_players %>">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="game_condition" class="form-label fw-bold">Condition</label>
                            <input type="text" class="form-control" id="game_condition" name="game_condition" value="<%= game.game_condition %>">
                        </div>

                        <div class="mb-3">
                            <label for="image" class="form-label fw-bold">Update Image <span class="hint">(Leave empty to keep current)</span></label>
                            <input type="file" class="form-control" id="image" name="image" accept="image/jpeg, image/png">
                            <input type="hidden" name="existing_image" value="<%= game.image_url %>">
                        </div>

                        <div class="mb-4">
                            <label for="description" class="form-label fw-bold">Description</label>
                            <textarea class="form-control" id="description" name="description" rows="4"><%= game.description %></textarea>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="/games/<%= game.game_id %>" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-warning px-4">Update Game</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>