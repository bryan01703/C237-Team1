<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-danger mt-5">
                <div class="card-body p-5">
                    <h1 class="display-1 text-danger">⚠️</h1>
                    <h2 class="mb-4">Oops! Something went wrong.</h2>
                    
                    <div class="alert alert-warning">
                        <!-- This will print the exact error message sent from app.js or authMiddleware.js -->
                        <strong><%= message || 'An unexpected error occurred.' %></strong>
                    </div>

                    <div class="mt-4">
                        <a href="/login" class="btn btn-primary px-4">Go to Login</a>
                        <a href="/games" class="btn btn-outline-secondary px-4">Back to Catalog</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<%- include('partials/footer') %>