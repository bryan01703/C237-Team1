<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container py-5">

    <a
        href="/games"
        class="btn btn-outline-secondary mb-4"
    >
        &larr; Back to Catalogue
    </a>

    <div class="card shadow-sm">

        <div class="row g-0">

            <div class="col-md-5">

                <% if (game.image_url) { %>

                    <img
                        src="<%=
                            game.image_url.startsWith('http')
                                ? game.image_url
                                : '/images/' + game.image_url
                        %>"
                        class="img-fluid game-detail-image"
                        alt="<%= game.title %>"
                    >

                <% } else { %>

                    <div class="game-detail-placeholder">
                        No image available
                    </div>

                <% } %>

            </div>

            <div class="col-md-7">

                <div class="card-body p-4">

                    <div
                        class="d-flex justify-content-between align-items-start gap-3 mb-4"
                    >
                        <h1 class="fw-bold mb-0">
                            <%= game.title %>
                        </h1>

                        <% if (game.availability === 'available') { %>

                            <span class="badge bg-success fs-6">
                                Available
                            </span>

                        <% } else { %>

                            <span class="badge bg-danger fs-6">
                                Unavailable
                            </span>

                        <% } %>
                    </div>

                    <p>
                        <strong>Genre:</strong>
                        <%= game.genre || 'Not specified' %>
                    </p>

                    <p>
                        <strong>Players:</strong>

                        <% if (game.min_players != null && game.max_players != null) { %>

                            <%= game.min_players === game.max_players
                                ? game.min_players
                                : game.min_players + '–' + game.max_players %>

                        <% } else { %>

                            Not specified

                        <% } %>
                    </p>

                    <p>
                        <strong>Difficulty:</strong>

                        <span class="text-capitalize">
                            <%= game.difficulty || 'Not specified' %>
                        </span>
                    </p>

                    <p>
                        <strong>Condition:</strong>

                        <span class="text-capitalize">
                            <%= game.game_condition || 'Not specified' %>
                        </span>
                    </p>

                    <p>
                        <strong>Description:</strong>
                    </p>

                    <p class="text-muted">
                        <%= game.description || 'No description available.' %>
                    </p>

                    <% if (
                        game.availability === 'unavailable' &&
                        game.due_date
                    ) { %>

                        <div class="alert alert-warning">
                            Expected return date:

                            <strong>
                                <%= new Intl.DateTimeFormat('en-SG', {
                                    day: 'numeric', month: 'short', year: 'numeric',
                                    timeZone: 'Asia/Singapore'
                                }).format(new Date(game.due_date)) %>
                            </strong>
                        </div>

                    <% } %>

                    <div class="mt-4">

                        <% if (!user) { %>

                            <a
                                href="/login"
                                class="btn btn-primary"
                            >
                                Login to Borrow
                            </a>

                        <% } else if (
                            user.role === 'member' &&
                            game.availability === 'available'
                        ) { %>

                            <form
                                action="/borrow/<%= game.game_id %>"
                                method="POST"
                            >
                                <button
                                    type="submit"
                                    class="btn btn-primary"
                                >
                                    Request to Borrow
                                </button>
                            </form>

                        <% } else if (
                            user.role === 'member' &&
                            game.availability === 'unavailable'
                        ) { %>

                            <form
                                action="/waitlist/<%= game.game_id %>"
                                method="POST"
                            >
                                <button
                                    type="submit"
                                    class="btn btn-warning"
                                >
                                    Join Waitlist
                                </button>
                            </form>

                        <% } else if (user.role === 'admin') { %>

                            <a
                                href="/games/edit/<%= game.game_id %>"
                                class="btn btn-outline-primary"
                            >
                                Edit Game
                            </a>

                        <% } %>

                    </div>

                </div>

            </div>

        </div>

    </div>

</main>

<%- include('../partials/footer') %>
