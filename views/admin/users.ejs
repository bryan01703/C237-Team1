<!DOCTYPE html>
<html>
<head><title>Manage Users</title></head>
<head>
    <title>Manage Users</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <%- include('../partials/header') %>

    <section class="hero">
    <h2>Manage Users</h2>
    <table class="admin-table">
        <tr>
            <th>Username</th>
            <th>Role</th>
            <th>Action</th>
        </tr>
        <% users.forEach(u => { %>
        <tr>
            <td><%= u.username %></td>
            <td><%= u.role %></td>
            <td><a href="/admin/users/edit/<%= u.user_id %>">Edit</a></td>
        </tr>
        <% }) %>
    </table>
    </section>

    <%- include('../partials/footer') %>
</body>
</html>