<!DOCTYPE html>
<html>
<head>
    <title>My Profile — GameNight</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=IBM+Plex+Mono:wght@400;600&family=Inter:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header class="site-header">
        <div class="brand">
            <span class="brand-mark">⚄</span>
            <span class="brand-name">GameNight</span>
        </div>
        <nav class="header-nav">
            <a href="/dashboard">Dashboard</a>
            <a href="/logout">Log out</a>
        </nav>
    </header>

    <section class="form-section">
        <div class="index-card form-card">
            <span class="card-hole"></span>
            <span class="card-no">ACCOUNT</span>
        <div class="profile-banner">
        <div class="profile-avatar">
            <%= profileUser.username.charAt(0).toUpperCase() %>
        </div>

        <div class="profile-info">
            <h1><%= profileUser.username %></h1>
            <p class="role-stamp role-<%= profileUser.role %>">
                <%= profileUser.role %>
            </p>
        </div>
    </div>

            <% if (typeof error !== 'undefined' && error.length > 0) { %>
                <p class="flash flash-error"><%= error[0] %></p>
            <% } %>
            <% if (typeof success !== 'undefined' && success.length > 0) { %>
                <p class="flash flash-success"><%= success[0] %></p>
            <% } %>

            <div class="profile-summary">
            <div class="summary-item">
                <span>Username</span>
                <strong><%= profileUser.username %></strong>
            </div>
            </div>
              
            <div class="profile-stats">

                <div class="stat-card">
                    <span>Total Borrowed</span>
                    <strong><%= stats.total %></strong>
                </div>

                <div class="stat-card">
                    <span>Currently Borrowed</span>
                    <strong><%= stats.current %></strong>
                </div>

                <div class="stat-card">
                    <span>Returned</span>
                    <strong><%= stats.returned %></strong>
                </div>

                <div class="stat-card">
                    <span>Overdue</span>
                    <strong><%= stats.overdue %></strong>
                </div>

            </div>

            <form action="/profile" method="POST">
                <label>Username</label>
                <input type="text" name="username" value="<%= profileUser.username %>" required>

                <label>New Password <span class="hint">(leave blank to keep current)</span></label>
                <input type="password" name="password" placeholder="••••••••">

                <button type="submit" class="stamp-button">Save Changes</button>
            </form>
            <hr class="profile-divider">
            <h2>Borrow History</h2>
            <% if (borrowHistory.length === 0) { %>
                <p>You haven't borrowed any games yet.</p>
            <% } else { %>
            <table class="history-table">
                <thead>
                    <tr>
                        <th>Game</th>
                        <th>Borrowed</th>
                        <th>Due</th>
                        <th>Returned</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                <% borrowHistory.forEach(record => { %>
                    <tr>
                        <td><%= record.title %></td>
                        <td><%= record.borrow_date %></td>
                        <td><%= record.due_date %></td>
                        <td><%= record.return_date || "-" %></td>
                        <td>
                            <span class="status-pill status-<%= record.status.toLowerCase() %>">
                                <%= record.status %>
                            </span>
                        </td>
                    </tr>
                <% }) %>
                </tbody>
            </table>
            <% } %>

        </div>
    </section>
</body>
</html>