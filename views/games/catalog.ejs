<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container py-5" aria-labelledby="catalog-title">

    <div class="mb-4 d-flex justify-content-between align-items-center">
        <div>
            <h1 id="catalog-title" class="fw-bold">Board Game Catalogue</h1>
            <p class="text-muted mb-0">
                Browse our community board game collection and check live availability.
            </p>
        </div>
        <!-- Only show the Add button if the user is logged in AND is an admin -->
        <% if (user && user.role === 'admin') { %>
            <div>
                <a href="/games/add" class="btn btn-success px-4 fw-bold">+ Add New Game</a>
            </div>
        <% } %>
    </div>

    <% if (!games || games.length === 0) { %>

        <div class="alert alert-info">
            No games were found in the catalogue.
        </div>

    <% } else { %>

        <div class="row g-4">

            <% games.forEach(game => { %>

                <div class="col-sm-6 col-lg-4">

                    <div class="card h-100 shadow-sm">

                        <% if (game.image_url) { %>

                            <img
                                src="<%=
                                    game.image_url.startsWith('http')
                                        ? game.image_url
                                        : '/images/' + game.image_url
                                %>"
                                class="card-img-top game-card-image"
                                alt="<%= game.title %>"
                            >

                        <% } else { %>

                            <div class="game-image-placeholder">
                                No image available
                            </div>

                        <% } %>

                        <div class="card-body">

                            <div
                                class="d-flex justify-content-between align-items-start gap-2 mb-3"
                            >
                                <h2 class="card-title h4 mb-0">
                                    <%= game.title %>
                                </h2>

                                <% if (game.availability === 'available') { %>

                                    <span class="badge bg-success">
                                        Available
                                    </span>

                                <% } else { %>

                                    <span class="badge bg-danger">
                                        Unavailable
                                    </span>

                                <% } %>
                            </div>

                            <p class="card-text mb-2">
                                <strong>Genre:</strong>
                                <%= game.genre || 'Not specified' %>
                            </p>

                            <p class="card-text mb-2">
                                <strong>Players:</strong>

                                <% if (game.min_players != null && game.max_players != null) { %>

                                    <%= game.min_players === game.max_players
                                        ? game.min_players
                                        : game.min_players + '–' + game.max_players %>

                                <% } else { %>

                                    Not specified

                                <% } %>
                            </p>

                            <p class="card-text mb-2">
                                <strong>Difficulty:</strong>
                                <span class="text-capitalize">
                                    <%= game.difficulty || 'Not specified' %>
                                </span>
                            </p>

                            <p class="card-text mb-2">
                                <strong>Condition:</strong>
                                <span class="text-capitalize">
                                    <%= game.game_condition || 'Not specified' %>
                                </span>
                            </p>

                            <p class="card-text text-muted">
                                <% if (game.description) { %>

                                    <%= game.description.length > 100
                                        ? game.description.substring(0, 100) + '...'
                                        : game.description
                                    %>

                                <% } else { %>

                                    No description available.

                                <% } %>
                            </p>

                        </div>

                        <div class="card-footer bg-white border-0 pb-3">
                            <a
                                href="/games/<%= game.game_id %>"
                                class="btn btn-primary w-100 mb-2"
                                aria-label="View details for <%= game.title %>"
                            >
                                View Details
                            </a>

                            <!-- Only show the Edit button on the card if the user is an admin -->
                            <% if (user && user.role === 'admin') { %>
                                <a 
                                    href="/games/edit/<%= game.game_id %>" 
                                    class="btn btn-warning w-100 fw-bold"
                                >
                                    Edit Game
                                </a>
                            <% } %>
                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } %>

</main>

<%- include('../partials/footer') %>
