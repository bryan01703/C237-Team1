<nav>
    <% if (user) { %>
        <span>Hi, <%= user.username %> (<%= user.role %>)</span>
        <a href="/dashboard">Dashboard</a>
        <a href="/profile">My Profile</a>
        <% if (user.role === 'admin') { %>
            <a href="/admin/users">Manage Users</a>
        <% } %>
        <a href="/logout">Logout</a>
    <% } else { %>
        <a href="/login">Login</a>
        <a href="/register">Register</a>
    <% } %>
</nav>