<!DOCTYPE html>
<html>
<head><title>Edit User</title></head>
<head>
    <title>Edit User</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <%- include('../partials/header') %>
    <section class="hero">
    <h2>Edit User: <%= user.username %></h2>
    
    <form action="/admin/users/edit/<%= user.user_id %>" method="POST">
        <label for="username">Username:</label><br>
        <input type="text" id="username" name="username" value="<%= user.username %>" required><br><br>

        <label for="password">New Password:</label><br>
        <input type="password" id="password" name="password" placeholder="Leave blank to keep current password"><br><br>
        
        <label for="role">Role:</label><br>
       <select id="role" name="role">
            <option value="member" <%= user.role === 'member' ? 'selected' : '' %>>Member</option>
            <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>Admin</option>
        </select><br><br>

        <button type="submit" class="cta-button">Save Changes</button>
    </form>
    <hr>

    <h2>Borrowing History</h2>

    <% if (!borrowHistory || borrowHistory.length === 0) { %>
        <p>This user has no borrowing history.</p>
    <% } else { %>
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Book Name</th>
                    <th>Status</th>
                    <th>Date Borrowed</th>
                    <th>Due Date</th>
                    <th>Date Returned</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                <% borrowHistory.forEach(record => { %>
                    <tr>
                        <td>
                            <form
                                id="borrow-update-<%= record.record_id %>"
                                action="/admin/users/<%= user.user_id %>/borrow/<%= record.record_id %>/update"
                                method="POST"
                                style="display: none;"
                            ></form>

                            <form
                                id="borrow-delete-<%= record.record_id %>"
                                action="/admin/users/<%= user.user_id %>/borrow/<%= record.record_id %>/delete"
                                method="POST"
                                style="display: none;"
                                onsubmit="return confirm('Delete this borrowing record? This cannot be undone.');"
                            ></form>

                            <%= record.title %>
                        </td>

                        <td>
                            <select
                                name="status"
                                form="borrow-update-<%= record.record_id %>"
                            >
                                <option
                                    value="active"
                                    <%= record.status === 'active' ? 'selected' : '' %>
                                >
                                    Active
                                </option>

                                <option
                                    value="returned"
                                    <%= record.status === 'returned' ? 'selected' : '' %>
                                >
                                    Returned
                                </option>
                            </select>
                        </td>

                        <td>
                            <input
                                type="date"
                                name="borrow_date"
                                form="borrow-update-<%= record.record_id %>"
                                value="<%= new Date(record.borrow_date).toISOString().slice(0, 10) %>"
                                required
                            >
                        </td>

                        <td>
                            <input
                                type="date"
                                name="due_date"
                                form="borrow-update-<%= record.record_id %>"
                                value="<%= new Date(record.due_date).toISOString().slice(0, 10) %>"
                                required
                            >
                        </td>

                        <td>
                            <input
                                type="date"
                                name="return_date"
                                form="borrow-update-<%= record.record_id %>"
                                value="<%= record.return_date
                                    ? new Date(record.return_date).toISOString().slice(0, 10)
                                    : '' %>"
                            >
                        </td>

                        <td>
                            <button
                                type="submit"
                                form="borrow-update-<%= record.record_id %>"
                                class="btn btn-primary"
                                style="background-color: #A85D45; border-color: #A85D45; color: white;"
                            >
                                Save
                            </button>

                            <button
                                type="submit"
                                form="borrow-delete-<%= record.record_id %>"
                                class="btn btn-primary"
                                style="background-color: #A85D45; border-color: #A85D45; color: white;"
                            >
                                Delete
                            </button>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>
    </section>
    
    <%- include('../partials/footer') %>
</body>
</html>