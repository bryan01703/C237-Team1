<%- include('../partials/header') %>

<main class="container py-5">
    <a href="/games" class="btn btn-outline-secondary mb-4">&larr; Back to Catalogue</a>

    <!-- flash messages -->
    <% if (error && error.length > 0) { %>
        <div class="alert alert-danger"><%= error[0] %></div>
    <% } %>
    <% if (success && success.length > 0) { %>
        <div class="alert alert-success"><%= success[0] %></div>
    <% } %>

    <div class="card shadow-sm">
        <div class="row g-0">
            <div class="col-md-5">
                <% if (game.image_url) { %>
                    <img
                        src="<%=
                            game.image_url.startsWith('http')
                                ? game.image_url
                                : '/images/' + game.image_url
                        %>"
                        class="img-fluid game-detail-image"
                        alt="<%= game.title %>"
                    >
                <% } else { %>
                    <div class="game-detail-placeholder">
                        No image available
                    </div>
                <% } %>
            </div>
            <div class="col-md-7">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
                        <h1 class="fw-bold mb-0">
                            <%= game.title %>
                        </h1>
                        <% if (game.availability === 'available') { %>
                            <span class="badge bg-success fs-6">
                                Available
                            </span>
                        <% } else { %>
                            <span class="badge bg-danger fs-6">
                                Unavailable
                            </span>
                        <% } %>
                    </div>

                    <p>
                        <strong>Genre:</strong>
                        <%= game.genre || 'Not specified' %>
                    </p>

                    <p>
                        <strong>Players:</strong>
                        <% if (game.min_players != null && game.max_players != null) { %>
                            <%= game.min_players === game.max_players
                                ? game.min_players
                                : game.min_players + '–' + game.max_players %>
                        <% } else { %>
                            Not specified
                        <% } %>
                    </p>

                    <p>
                        <strong>Difficulty:</strong>
                        <span class="text-capitalize">
                            <%= game.difficulty || 'Not specified' %>
                        </span>
                    </p>

                    <p>
                        <strong>Condition:</strong>
                        <span class="text-capitalize">
                            <%= game.game_condition || 'Not specified' %>
                        </span>
                    </p>

                    <p>
                        <strong>Description:</strong>
                    </p>

                    <p class="text-muted">
                        <%= game.description || 'No description available.' %>
                    </p>

                    <% if (
                        game.availability === 'unavailable' &&
                        game.due_date
                    ) { %>

                        <div class="alert alert-warning">
                            Expected return date:
                            <strong>
                                <%= new Intl.DateTimeFormat('en-SG', {
                                    day: 'numeric', month: 'short', year: 'numeric',
                                    timeZone: 'Asia/Singapore'
                                }).format(new Date(game.due_date)) %>
                            </strong>
                        </div>

                    <% } %>

                    <div class="mt-4">
                        <% if (!user) { %>
                            <a href="/login" class="btn btn-primary">
                                Login to Borrow
                            </a>
                        <% } else if (
                            user.role === 'member' &&
                            game.availability === 'available'
                        ) { %>

                            <form action="/borrow/<%= game.game_id %>" method="POST">
                                <button type="submit" class="btn btn-primary">
                                    Request to Borrow
                                </button>
                            </form>
                        <% } else if (
                            user.role === 'member' &&
                            game.availability === 'unavailable'
                        ) { %>
                            <form action="/waitlist/<%= game.game_id %>" method="POST">
                                <button type="submit" class="btn btn-warning">
                                    Join Waitlist
                                </button>
                            </form>
                            <span class="btn btn-secondary disabled">
                                Currently Unavailable
                            </span>
                        <% } else if (user.role === 'admin') { %>
                            <div class="d-flex align-items-center gap-2">
                                <a href="/games/edit/<%= game.game_id %>" class="btn btn-outline-primary">Edit Game</a>

                                <% if (game.archived) { %>
                                    <form action="/games/unretire/<%= game.game_id %>" method="POST" class="m-0">
                                        <button type="submit" class="btn btn-success">Unretire Game</button>
                                    </form>
                                <% } else { %>
                                    <form action="/games/retire/<%= game.game_id %>" method="POST" class="m-0">
                                        <button type="submit" class="btn btn-warning" onclick="return confirm('Are you sure you want to retire this game? It will hide it from the public catalog.')">Retire</button>
                                    </form>
                                <% } %>

                                <form action="/games/delete/<%= game.game_id %>" method="POST" class="m-0">
                                    <button type="submit" class="btn btn-danger" onclick="return confirm('WARNING: Permanent Delete! Use Retire instead if this game was ever borrowed. Continue?')">Delete</button>
                                </form>
                            </div>
                        <% } %>

                        <% if (user && user.role === 'member') { %>
                            <div class="mt-3">
                                <% if (isWishlisted) { %>
                                    <form
                                        action="/wishlist/game/<%= game.game_id %>/remove"
                                        method="POST"
                                        class="d-inline"
                                    >
                                        <button
                                            type="submit"
                                            class="btn btn-outline-danger ms-2"
                                            onclick="return confirm('Are you sure you want to remove this game from your wishlist?');"
                                        >
                                            Remove from Wishlist
                                        </button>
                                    </form>
                                <% } else { %>
                                    <form
                                        action="/wishlist/<%= game.game_id %>"
                                        method="POST"
                                        class="d-inline"
                                    >
                                        <button
                                            type="submit"
                                            class="btn btn-warning ms-2"
                                        >
                                            Add to Wishlist
                                        </button>
                                    </form>
                                <% } %>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Reviews CRUD interface: create, read, update and delete reviews. -->
    <section class="reviews-section mt-5" aria-labelledby="reviews-title">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
            <div>
                <h2 id="reviews-title" class="mb-1">Reviews &amp; Ratings</h2>
                <% if (Number(game.review_count) > 0) { %>
                    <p class="mb-0">
                        <span class="rating-stars" aria-hidden="true">★</span>
                        <strong><%= Number(game.average_rating).toFixed(1) %>/5</strong>
                        from <%= game.review_count %> review<%= Number(game.review_count) === 1 ? '' : 's' %>
                    </p>
                <% } else { %>
                    <p class="text-muted mb-0">No reviews yet. Be the first to review this game.</p>
                <% } %>
            </div>
        </div>

        <!-- Show Create only when this member has not reviewed the game. -->
        <% const myReview = user && reviews
            ? reviews.find(review => Number(review.user_id) === Number(user.id))
            : null; %>

        <% if (!user) { %>
            <div class="alert alert-info">
                <a href="/login">Log in</a> to add a review.
            </div>
        <% } else if (user.role === 'member' && !myReview) { %>
            <div class="review-form-card mb-4">
                <h3 class="h5">Write a Review</h3>
                <form action="/reviews/games/<%= game.game_id %>" method="POST">
                    <div class="mb-3">
                        <label for="rating" class="form-label">Rating</label>
                        <select id="rating" name="rating" class="form-select" required>
                            <option value="">Select a rating</option>
                            <option value="5">5 - Excellent</option>
                            <option value="4">4 - Very good</option>
                            <option value="3">3 - Good</option>
                            <option value="2">2 - Fair</option>
                            <option value="1">1 - Poor</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="comment" class="form-label">Comment (optional)</label>
                        <textarea id="comment" name="comment" class="form-control"
                            rows="4" maxlength="500"
                            placeholder="Share your experience with this game..."></textarea>
                        <div class="form-text">Maximum 500 characters.</div>
                    </div>
                    <button type="submit" class="btn btn-primary">Submit Review</button>
                </form>
            </div>
        <% } %>

        <% if (reviews && reviews.length > 0) { %>
            <div class="review-list">
                <% reviews.forEach(review => { %>
                    <% const ownsReview = user && Number(review.user_id) === Number(user.id); %>
                    <article class="review-card mb-3">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div>
                                <h3 class="h6 mb-1"><%= review.username %></h3>
                                <div class="rating-stars" aria-label="<%= review.rating %> out of 5 stars">
                                    <%= '★'.repeat(review.rating) %><span class="empty-stars"><%= '☆'.repeat(5 - review.rating) %></span>
                                </div>
                            </div>
                            <small class="text-muted">
                                <%= new Intl.DateTimeFormat('en-SG', {
                                    day: 'numeric', month: 'short', year: 'numeric',
                                    timeZone: 'Asia/Singapore'
                                }).format(new Date(review.updated_at)) %>
                            </small>
                        </div>

                        <% if (review.comment) { %>
                            <p class="review-comment mt-3 mb-3"><%= review.comment %></p>
                        <% } %>

                        <!-- Only the review owner receives the Edit controls. -->
                        <% if (ownsReview) { %>
                            <details class="review-edit mt-3">
                                <summary class="btn btn-outline-secondary">Edit Review</summary>
                                <form action="/reviews/<%= review.review_id %>/edit" method="POST" class="mt-3">
                                    <input type="hidden" name="game_id" value="<%= game.game_id %>">
                                    <div class="mb-3">
                                        <label for="rating-<%= review.review_id %>" class="form-label">Rating</label>
                                        <select id="rating-<%= review.review_id %>" name="rating" class="form-select" required>
                                            <% for (let score = 5; score >= 1; score--) { %>
                                                <option value="<%= score %>" <%= review.rating === score ? 'selected' : '' %>>
                                                    <%= score %> / 5
                                                </option>
                                            <% } %>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label for="comment-<%= review.review_id %>" class="form-label">Comment</label>
                                        <textarea id="comment-<%= review.review_id %>" name="comment"
                                            class="form-control" rows="3" maxlength="500"><%= review.comment || '' %></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-primary">Save Changes</button>
                                </form>
                            </details>
                        <% } %>

                        <!-- Owners can delete their review; admins can moderate all reviews. -->
                        <% if (ownsReview || (user && user.role === 'admin')) { %>
                            <form action="/reviews/<%= review.review_id %>/delete" method="POST" class="mt-3"
                                onsubmit="return confirm('Delete this review?');">
                                <input type="hidden" name="game_id" value="<%= game.game_id %>">
                                <button type="submit" class="btn btn-outline-danger">Delete Review</button>
                            </form>
                        <% } %>
                    </article>
                <% }) %>
            </div>
        <% } %>
    </section>

</main>

<%- include('../partials/footer') %>